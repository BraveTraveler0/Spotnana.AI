# Environment variables - never commit these
.env
.env.local
.env.*.local

# Dependencies
node_modules/

# Build output
dist/

# Vite
.vite/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Claude Code
.claude/

# Iris Feed — daily-generated personal content (briefs, events, reviews),
# not application source. README.md is the one file worth keeping tracked.
iris-feed/*.md
iris-feed/*.json
!iris-feed/README.md

# Android signing keys and local build settings never belong in the repo
*.jks
*.keystore
keystore.properties
src-tauri/gen/android/local.properties

# Installer artifacts and local logs stay out of the repo
Artemis-AI-Installer.msi
Artemis-AI-Setup.exe
Artemis-Desktop-Installer.zip
.git-autopush.log
scripts/feed-server.log
